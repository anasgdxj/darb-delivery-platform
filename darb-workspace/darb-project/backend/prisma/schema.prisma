generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

// ============ Enums ============

enum UserRole {
  CUSTOMER
  VENDOR
  DRIVER
  ADMIN
}

enum VendorStatus {
  PENDING
  APPROVED
  SUSPENDED
  REJECTED
}

enum DriverStatus {
  PENDING
  APPROVED
  SUSPENDED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum OrderType {
  VENDOR_ORDER
  PEER_DELIVERY
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY
  ASSIGNED
  PICKED_UP
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  WALLET
  BANK_TRANSFER
  ONLINE
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

enum Locale {
  ar
  tr
  en
}

enum AiDraftSource {
  TEXT
  AUDIO
}

enum AiDraftStatus {
  PROCESSING
  READY
  NEEDS_REVIEW
  FAILED
}

enum AiDraftIntent {
  STORE_ORDER
  PEER_DELIVERY
  UNCLEAR
}

// ============ Users ============

model User {
  id        String   @id @default(uuid())
  phone     String?  @unique
  email     String?  @unique
  googleId  String?  @unique
  name      String?
  role      UserRole @default(CUSTOMER)
  locale    Locale   @default(ar)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendor           Vendor?
  driver           Driver?
  addresses        Address[]
  ordersAsCustomer Order[]   @relation("CustomerOrders")
  reviews          Review[]
  devices          UserDevice[]
  aiOrderDrafts     AiOrderDraft[]
}

// ============ Cities ============

model City {
  id               String   @id @default(uuid())
  code             String   @unique
  defaultCurrency  String   @default("SYP") @db.VarChar(3)
  supportedLocales Locale[]
  isActive         Boolean  @default(false)
  boundary         Unsupported("geography(Polygon,4326)")?
  createdAt        DateTime @default(now())

  names   CityTranslation[]
  vendors VendorCity[]
  drivers Driver[]
  orders  Order[]
  zone    DeliveryZone?
}

model CityTranslation {
  id     String @id @default(uuid())
  cityId String
  locale Locale
  name   String

  city City @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@unique([cityId, locale])
}

// ============ Vendors ============

model Vendor {
  id              String       @id @default(uuid())
  userId          String       @unique
  type            String
  status          VendorStatus @default(PENDING)
  isOpen          Boolean      @default(true)
  commercialRegNo String?
  ratingAvg       Decimal      @default(0) @db.Decimal(3, 2)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  translations VendorTranslation[]
  cities       VendorCity[]
  location     VendorLocation?
  products     Product[]
  orders       Order[]
  reviews      Review[]
}

model VendorTranslation {
  id          String  @id @default(uuid())
  vendorId    String
  locale      Locale
  name        String
  description String?

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, locale])
}

model VendorCity {
  vendorId String
  cityId   String

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  city   City   @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@id([vendorId, cityId])
}

model VendorLocation {
  vendorId  String                        @id
  cityId    String
  address   String?
  point     Unsupported("geography(Point,4326)")?
  updatedAt DateTime                      @updatedAt

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
}

// ============ Catalog ============

model Product {
  id          String   @id @default(uuid())
  vendorId    String
  basePrice   Decimal  @db.Decimal(12, 2)
  currency    String   @default("SYP") @db.VarChar(3)
  category    String?  @db.VarChar(80)
  isAvailable Boolean  @default(true)
  stockQty    Int?
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vendor       Vendor               @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  translations ProductTranslation[]
  variants     ProductVariant[]
  orderItems   OrderItem[]
  aiDraftItems AiOrderDraftItem[]

  @@index([vendorId, isAvailable])
  @@index([vendorId, category])
}

model ProductTranslation {
  id          String  @id @default(uuid())
  productId   String
  locale      Locale
  name        String
  description String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
}

model ProductVariant {
  id          String  @id @default(uuid())
  productId   String
  sku         String? @unique
  attributes  Json
  priceDelta  Decimal @default(0) @db.Decimal(12, 2)
  stockQty    Int?
  isAvailable Boolean @default(true)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
}

// ============ Addresses & Drivers ============

model Address {
  id        String   @id @default(uuid())
  userId    String
  label     String?
  details   String?
  point     Unsupported("geography(Point,4326)")?
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]
}

model Driver {
  id          String       @id @default(uuid())
  userId      String       @unique
  cityId      String
  status      DriverStatus @default(PENDING)
  vehicleType String?
  isOnline    Boolean      @default(false)
  createdAt   DateTime     @default(now())

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  city            City            @relation(fields: [cityId], references: [id])
  currentLocation DriverLocation?
  orders          Order[]
  deliveryOffers  DeliveryOffer[]

  @@index([cityId, isOnline, status])
}

// آخر موقع فقط، لا يُحفظ تاريخ التحركات
model DriverLocation {
  driverId  String                        @id
  point     Unsupported("geography(Point,4326)")?
  updatedAt DateTime                      @updatedAt

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)
}

model DeliveryZone {
  id       String  @id @default(uuid())
  cityId   String  @unique
  name     String
  feeBase  Decimal @default(0) @db.Decimal(12, 2)
  feePerKm Decimal @default(0) @db.Decimal(12, 2)

  city City @relation(fields: [cityId], references: [id], onDelete: Cascade)
}

// ============ Orders ============

model Order {
  id            String      @id @default(uuid())
  orderNumber   String      @unique
  type          OrderType
  status        OrderStatus @default(PENDING)
  cityId        String
  customerId    String
  vendorId      String?
  driverId      String?
  addressId     String
  pickupAddress String?
  pickupLatitude  Float?
  pickupLongitude Float?
  currency      String      @default("SYP") @db.VarChar(3)
  subtotal      Decimal     @db.Decimal(12, 2)
  deliveryFee   Decimal     @db.Decimal(12, 2)
  total         Decimal     @db.Decimal(12, 2)
  notes         String?
  cancelReason  String?     @db.VarChar(240)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  city          City                 @relation(fields: [cityId], references: [id])
  customer      User                 @relation("CustomerOrders", fields: [customerId], references: [id])
  vendor        Vendor?              @relation(fields: [vendorId], references: [id])
  driver        Driver?              @relation(fields: [driverId], references: [id])
  address       Address              @relation(fields: [addressId], references: [id])
  items         OrderItem[]
  payment       Payment?
  statusHistory OrderStatusHistory[]
  reviews       Review[]
  deliveryOffers DeliveryOffer[]

  @@index([customerId, createdAt])
  @@index([vendorId, status])
  @@index([driverId, status])
  @@index([cityId, status])
}


model DeliveryOffer {
  id        String      @id @default(uuid())
  orderId   String
  driverId  String
  amount    Decimal     @db.Decimal(12, 2)
  currency  String      @db.VarChar(3)
  status    OfferStatus @default(PENDING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([orderId, driverId])
  @@index([orderId, status, amount])
  @@index([driverId, status, createdAt])
}

model OrderItem {
  id           String  @id @default(uuid())
  orderId      String
  productId    String
  variantId    String?
  quantity     Int
  unitPrice    Decimal @db.Decimal(12, 2)
  currency     String  @db.VarChar(3)
  nameSnapshot String

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])
}

model OrderStatusHistory {
  id        String      @id @default(uuid())
  orderId   String
  status    OrderStatus
  changedBy String?
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model Payment {
  id          String        @id @default(uuid())
  orderId     String        @unique
  method      PaymentMethod
  status      PaymentStatus @default(PENDING)
  amount      Decimal       @db.Decimal(12, 2)
  currency    String        @db.VarChar(3)
  provider    String?
  externalRef String?       @unique
  createdAt   DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Review {
  id        String   @id @default(uuid())
  orderId   String
  authorId  String
  vendorId  String?
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  order  Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  author User    @relation(fields: [authorId], references: [id])
  vendor Vendor? @relation(fields: [vendorId], references: [id])
}



model UserDevice {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  String?  @db.VarChar(20)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}



model AiOrderDraft {
  id             String         @id @default(uuid())
  userId         String
  cityId         String
  vendorId       String?
  idempotencyKey String?        @db.VarChar(80)
  source         AiDraftSource
  status         AiDraftStatus  @default(PROCESSING)
  intent         AiDraftIntent  @default(UNCLEAR)
  originalText   String?        @db.Text
  transcript     String?        @db.Text
  locale         Locale         @default(ar)
  confidence     Float?
  warnings       Json?
  extraction     Json?
  errorCode      String?        @db.VarChar(60)
  expiresAt      DateTime
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  items   AiOrderDraftItem[]
  address AiAddressDraft?

  @@unique([userId, idempotencyKey])
  @@index([userId, status, createdAt])
  @@index([expiresAt])
}

model AiOrderDraftItem {
  id               String   @id @default(uuid())
  draftId          String
  productId        String?
  rawName          String   @db.VarChar(240)
  normalizedName   String?  @db.VarChar(240)
  quantity         Int      @default(1)
  unit             String?  @db.VarChar(40)
  confidence       Float?
  candidates       Json?
  createdAt        DateTime @default(now())

  draft   AiOrderDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  product Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([draftId])
  @@index([productId])
}

model AiAddressDraft {
  id                String   @id @default(uuid())
  draftId           String   @unique
  rawText           String?  @db.Text
  normalizedText    String?  @db.Text
  neighborhood      String?  @db.VarChar(160)
  street            String?  @db.VarChar(200)
  building          String?  @db.VarChar(160)
  landmark          String?  @db.VarChar(240)
  recipientName     String?  @db.VarChar(120)
  recipientPhone    String?  @db.VarChar(40)
  deliveryNotes     String?  @db.Text
  latitude          Float?
  longitude         Float?
  geocodeStatus     String   @default("PENDING") @db.VarChar(24)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  draft AiOrderDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
}

model PlatformSetting {
  key       String   @id @db.VarChar(80)
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actorRole  String?  @db.VarChar(24)
  action     String   @db.VarChar(80)
  targetType String   @db.VarChar(48)
  targetId   String?  @db.VarChar(80)
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([action, createdAt])
  @@index([createdAt])
}

