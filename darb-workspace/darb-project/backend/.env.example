NODE_ENV=development
PORT=3000

DATABASE_URL="postgresql://delivery:delivery@localhost:5432/delivery?schema=public"
REDIS_URL="redis://localhost:6379"

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
OTP_SECRET=change-me-otp-secret-min-32-chars

# مزود الرسائل النصية (مطلوب في production فقط)
SMS_API_URL=https://your-sms-provider.example/send
SMS_API_KEY=your-api-key


# MsgPlus (production)
SMS_PROVIDER=msgplus
MSGPLUS_API_KEY=your-msgplus-api-key
MSGPLUS_SENDER_NAME=your-approved-sender-name
MSGPLUS_TEMPLATE_ID=3

# Google AI Studio (server-side only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen
